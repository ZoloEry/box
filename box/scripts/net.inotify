#!/system/bin/sh

# 检查模块是否已禁用
if [ -f "/data/adb/modules/box_for_root/disable" ]; then
  exit 0
fi

events="$1"
# monitor_dir="$2"
# monitor_file="$3"

export PATH="/data/adb/magisk:/data/adb/ksu/bin:/data/adb/ap/bin:$PATH:/system/bin:/data/data/com.termux/files/usr/bin"

BASE_DIR="/data/adb/box"
case "$0" in
  */*)
    SCRIPTS_DIR="${0%/*}"
    ;;
  *)
    SCRIPTS_DIR="${BASE_DIR}/scripts"
    ;;
esac
LOG_DIR="${BASE_DIR}/run"
STATE_DIR="${BASE_DIR}/run/state"
BOX_PID_FILE="${BASE_DIR}/run/box.pid"

NET_LOG_FILE="${LOG_DIR}/net.log"

CTRL_LOG_FILE="${LOG_DIR}/netswitch.log"
CTRL_STATE_FILE="${STATE_DIR}/last_check_time"
CTRL_WIFI_STATE_FILE="${STATE_DIR}/last_wifi_state"
CTRL_BOOT_FILE="${STATE_DIR}/last_wifi_boot"
CTRL_STABILITY_WINDOW=3

# ex: 7.1.1
buildVersion=$(getprop ro.build.version.release)
minBuildVersion="11"
IPV="iptables"
IP6V="ip6tables"
buildVersionMajor=${buildVersion%%.*}
if [ "${buildVersionMajor}" -ge "${minBuildVersion}" ]; then
  IPV="iptables -w 100"
  IP6V="ip6tables -w 100"
fi

iptables="${IPV}"
ip6tables="${IP6V}"

ensure_dirs() {
  mkdir -p "${LOG_DIR}" "${STATE_DIR}" >/dev/null 2>&1 || true
}

net_log_info() {
  local previous_box_log="${box_log}"
  box_log="${NET_LOG_FILE}"
  log Info "$*" >/dev/null
  box_log="${previous_box_log}"
}

net_log_warn() {
  local previous_box_log="${box_log}"
  box_log="${NET_LOG_FILE}"
  log Warn "$*" >/dev/null
  box_log="${previous_box_log}"
}

net_log_debug() {
  local previous_box_log="${box_log}"
  box_log="${NET_LOG_FILE}"
  log Debug "$*" >/dev/null
  box_log="${previous_box_log}"
}

reset_event_logs() {
  ensure_dirs
  : > "${NET_LOG_FILE}" 2>/dev/null || true
}

control_log_msg() {
  [ "${inotify_log_enabled}" = "true" ] || return 0
  local previous_box_log="${box_log}"
  box_log="${CTRL_LOG_FILE}"
  log Info "$*" >/dev/null
  box_log="${previous_box_log}"
}

ensure_chain_and_flush() {
  local ipt_cmd="$1"
  local table_name="$2"
  local chain_name="$3"
  ${ipt_cmd} -t "${table_name}" -N "${chain_name}" >/dev/null 2>&1 || true
  ${ipt_cmd} -t "${table_name}" -F "${chain_name}" >/dev/null 2>&1 || true
}

append_rule_fast() {
  local ipt_cmd="$1"
  local table_name="$2"
  local chain_name="$3"
  shift 3
  ${ipt_cmd} -t "${table_name}" -A "${chain_name}" "$@" >/dev/null 2>&1
}

mode_needs_local_ip_mangle() {
  case "${network_mode}" in
    tproxy|enhance)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

mode_needs_local_ip_nat() {
  case "${network_mode}" in
    redirect|mixed|enhance)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

append_local_ip_ruleset() {
  local ipt_cmd="$1"
  local table_name="$2"
  local chain_name="$3"
  local local_ip="$4"

  append_rule_fast "${ipt_cmd}" "${table_name}" "${chain_name}" -d "${local_ip}" -p udp ! --dport 53 -j ACCEPT
  local rv1=$?
  append_rule_fast "${ipt_cmd}" "${table_name}" "${chain_name}" -d "${local_ip}" ! -p udp -j ACCEPT
  local rv2=$?

  if [ "${rv1}" = "0" ] || [ "${rv2}" = "0" ]; then
    return 0
  fi
  return 1
}

collect_local_ipv4_list() {
  ip -o -4 addr show up 2>/dev/null \
    | busybox awk '{print $4}' \
    | busybox sort -u \
    | busybox grep -vE '^127\.0\.0\.1$'
}

collect_local_ipv6_list() {
  ip -o -6 addr show up scope global 2>/dev/null \
    | busybox awk '{print $4}' \
    | busybox sort -u \
    | busybox grep -vE '^fd00'
}

update_local_ip_rules() {
  local v4_ok=0
  local v4_fail=0
  local v6_ok=0
  local v6_fail=0
  local need_mangle="false"
  local need_nat="false"
  local local_ipv4=""
  local local_ipv6=""
  local ok=""

  if mode_needs_local_ip_mangle; then
    need_mangle="true"
  fi
  if mode_needs_local_ip_nat; then
    need_nat="true"
  fi

  if [ "${need_mangle}" != "true" ] && [ "${need_nat}" != "true" ]; then
    net_log_debug "当前模式无需更新本地 IP 防回环规则"
    return 0
  fi

  if [ "${need_mangle}" = "true" ]; then
    net_log_debug "开始更新本地 IPv4 防回环规则"
    ensure_chain_and_flush "${iptables}" mangle LOCAL_IP_V4
  fi
  if [ "${need_nat}" = "true" ]; then
    ensure_chain_and_flush "${iptables}" nat LOCAL_IP_V4
  fi

  for local_ipv4 in $(collect_local_ipv4_list); do
    ok="true"

    if [ "${need_mangle}" = "true" ]; then
      append_local_ip_ruleset "${iptables}" mangle LOCAL_IP_V4 "${local_ipv4}" || ok="false"
    fi
    if [ "${need_nat}" = "true" ]; then
      append_local_ip_ruleset "${iptables}" nat LOCAL_IP_V4 "${local_ipv4}" || ok="false"
    fi

    if [ "${ok}" = "true" ]; then
      v4_ok=$((v4_ok + 1))
      net_log_debug "本地 IPv4 ${local_ipv4} 防回环规则已更新"
    else
      v4_fail=$((v4_fail + 1))
      net_log_warn "本地 IPv4 ${local_ipv4} 防回环规则更新失败"
    fi
  done

  if [ $((v4_ok + v4_fail)) -eq 0 ]; then
    net_log_debug "未检测到需要写入的本地 IPv4 地址"
  fi

  if [ "${need_mangle}" = "true" ]; then
    net_log_debug "开始更新本地 IPv6 防回环规则"
    ensure_chain_and_flush "${ip6tables}" mangle LOCAL_IP_V6
  fi

  for local_ipv6 in $(collect_local_ipv6_list); do
    ok="true"

    if [ "${need_mangle}" = "true" ]; then
      append_local_ip_ruleset "${ip6tables}" mangle LOCAL_IP_V6 "${local_ipv6}" || ok="false"
    fi

    if [ "${ok}" = "true" ]; then
      v6_ok=$((v6_ok + 1))
      net_log_debug "本地 IPv6 ${local_ipv6} 防回环规则已更新"
    else
      v6_fail=$((v6_fail + 1))
      net_log_warn "本地 IPv6 ${local_ipv6} 防回环规则更新失败"
    fi
  done

  if [ $((v6_ok + v6_fail)) -eq 0 ]; then
    net_log_debug "未检测到需要写入的本地 IPv6 地址"
  fi

  net_log_info "防回环规则更新完成: IPv4 成功=${v4_ok} 失败=${v4_fail}, IPv6 成功=${v6_ok} 失败=${v6_fail}"
}

check_stability_window() {
  local current
  local last=0

  current=$(date +%s)
  [ -f "${CTRL_STATE_FILE}" ] && last=$(cat "${CTRL_STATE_FILE}" 2>/dev/null || echo 0)

  if [ $((current - last)) -lt ${CTRL_STABILITY_WINDOW} ]; then
    control_log_msg "跳过：处于稳定窗口冷却期（$((current - last))秒）"
    return 1
  fi

  echo "${current}" > "${CTRL_STATE_FILE}"
  return 0
}

is_service_running() {
  [ -f "${BOX_PID_FILE}" ] && kill -0 "$(cat "${BOX_PID_FILE}" 2>/dev/null)" 2>/dev/null
}

start_service_if_needed() {
  if is_service_running; then
    control_log_msg "[跳过] 服务已在运行"
    return 0
  fi

  "${SCRIPTS_DIR}/box.service" start
  "${SCRIPTS_DIR}/box.iptables" enable
  control_log_msg "[启动] 服务已启动"
}

stop_service_if_needed() {
  if ! is_service_running; then
    control_log_msg "[跳过] 服务已停止"
    return 0
  fi

  "${SCRIPTS_DIR}/box.iptables" disable
  "${SCRIPTS_DIR}/box.service" stop
  control_log_msg "[停止] 服务已停止"
}

current_boot_id() {
  if [ -r /proc/sys/kernel/random/boot_id ]; then
    cat /proc/sys/kernel/random/boot_id 2>/dev/null
    return 0
  fi
  busybox stat -c '%Y' /proc/1 2>/dev/null
}

save_wifi_state() {
  printf '%s\n' "$1" > "${CTRL_WIFI_STATE_FILE}"
  current_boot_id > "${CTRL_BOOT_FILE}" 2>/dev/null
}

apply_network_control_policy() {
  [ "${enable_network_service_control}" = "true" ] || return 0

  if [ ! -f "${SCRIPTS_DIR}/ctr.utils" ]; then
    control_log_msg "警告：未找到 ctr.utils，跳过网络策略控制"
    return 0
  fi

  . "${SCRIPTS_DIR}/ctr.utils"
  check_stability_window || return 0

  local iface
  local wifi_status_text
  local wifi_status
  local ssid
  local bssid
  local wifi_ip=""
  local i

  iface=$(get_wifi_iface)
  wifi_status_text=$(cmd wifi status 2>/dev/null)
  wifi_status=$(is_wifi_connected "${iface}")
  ssid=$(get_current_ssid "${iface}" "${wifi_status_text}")
  bssid=$(get_current_bssid "${iface}" "${wifi_status_text}")

  control_log_msg "--- 网络状态检查 ---"

  if [ "${wifi_status}" = "wifi" ]; then
    for i in 1 2 3 4 5 6; do
      wifi_ip=$(get_wifi_ip "${iface}")
      [ -n "${wifi_ip}" ] && break
      busybox sleep 0.5
    done

    if [ -z "${wifi_ip}" ]; then
      control_log_msg "WiFi 连接中，等待 IP 地址"
      return 0
    fi

    control_log_msg "WiFi: ${ssid}, BSSID: ${bssid}, IP: ${wifi_ip}"
  else
    control_log_msg "WiFi: 已断开"
  fi

  local state_key="${wifi_status}|${ssid}|${bssid}|${wifi_ip}"
  local prev_key=""
  local prev_boot=""
  if [ -f "${CTRL_WIFI_STATE_FILE}" ]; then
    prev_key=$(cat "${CTRL_WIFI_STATE_FILE}" 2>/dev/null)
    prev_boot=$(cat "${CTRL_BOOT_FILE}" 2>/dev/null)
  fi
  # 状态缓存只在同一次开机周期内有效。否则重启后仍在同一 Wi-Fi 下时会被误判为
  # “网络状态未变化”，使 SSID 黑名单等策略在开机首次检查中被跳过（issue #42）。
  if [ "${state_key}" = "${prev_key}" ] && [ -n "${prev_boot}" ] && [ "${prev_boot}" = "$(current_boot_id)" ]; then
    control_log_msg "网络状态未变化，跳过策略"
    return 0
  fi
  save_wifi_state "${state_key}"

  if should_enable_service "${wifi_status}" "${ssid}" "${bssid}"; then
    control_log_msg "策略：启用服务"
    start_service_if_needed
  else
    control_log_msg "策略：禁用服务"
    stop_service_if_needed
  fi

  control_log_msg "完成"
}

# ==========================================================
# TUN 出网看门狗（eta 2026-10-20 添加，2026-10-22 重做判定逻辑）
# ----------------------------------------------------------
# 触发：/data/misc/net 变化（网络重建）后由 inotifyd 调用本脚本。
# 背景：mihomo 默认接口 monitor 在网络重建后偶发不再重新探测，
#       报 "[TUN] default interface lost by monitor"，TUN 出口为空，
#       表现为全设备断网，需切飞行模式或重启核心才能恢复。
#
# 分层判定（关键）：
#   1) 底层链路层：绑当前数据网卡探测，确认运营商侧真的能出去
#   2) TUN 层：TUN 设备存在、路由可用
#   3) 代理层：走 TUN 探测真实出网
#   只有“底层通 + 代理不通”才动手；底层不通只记录，不消耗任何额度。
#
# 动作与额度：
#   - reload 不计数，可反复尝试（轻量、无副作用）
#   - restart 必须等流程真正完成（新 PID + TUN 就绪）再判定，且仅在
#     “底层确认通、reload 后依然不通”时才算一次有效失败并计入额度
#   - 额度用尽后退化为低频轮询，网络自己恢复也会被记录
# 关闭方式：把下面 enabled 改为 false，或整段删除。
# ==========================================================
HEALTH_STATE_FILE="${STATE_DIR}/health_watch.last"
HEALTH_RESTART_FILE="${STATE_DIR}/health_restart.history"
HEALTH_LOCK_DIR="${STATE_DIR}/health.lock"
# 陈旧锁阈值：进程被强杀/重启后 /data 保留，锁目录会残留，
# 不清理的话看门狗此后永远 mkdir 失败、直接 return，等于完全失效。
HEALTH_LOCK_STALE=900
HEALTH_DELAY=8
# 探测地址缓存：首次从配置解析后复用，避免每次探测都读取配置文件
HEALTH_PROBE_URL_CACHE=""
HEALTH_COOLDOWN=30
HEALTH_RESTART_WINDOW=600
HEALTH_RESTART_LIMIT=2
HEALTH_RESTART_WAIT=45
# 重启流程就绪后额外等待：给 mihomo 加载 provider、重探接口留时间
HEALTH_RESTART_SETTLE=15
HEALTH_RECHECK_INTERVAL=120
HEALTH_RECHECK_ROUNDS=5
# 底层未就绪时的等待窗口：每 15 秒探测一次，最多 12 次（3 分钟）。
# 只用于覆盖“网络恢复后底层还在初始化”的抖动，不是等信号回来——
# 长时间无信号期间不做任何动作，恢复时的网络事件会重新触发本脚本。
HEALTH_UNDERLAY_RETRIES=12
HEALTH_UNDERLAY_INTERVAL=15
# 等待超时后再挂延时兜底：5 分钟后自动补查，最多 2 轮，
# 避免“恢复事件来得太早、之后又没有新事件”导致彻底错过。
HEALTH_DEFER_ROUNDS=2
HEALTH_DEFER_DELAY=300
HEALTH_DEFER_FILE="${STATE_DIR}/health_defer.state"

health_log() {
  local level="$1"
  shift
  ensure_dirs
  printf '%s [%s]: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "${level}" "$*" >> "${NET_LOG_FILE}" 2>/dev/null || true
}

# 找一个可用的底层出口网卡：
# 1) 优先向系统要“当前默认网络”的接口（多卡机器上最准）
# 2) 拿不到再回退到路由表推导（排除 TUN、dummy 等）
# 探测目标 URL：优先用用户自己配置的测速地址（proxy-groups / health-check 的 url），
# 过滤掉本地订阅地址；都取不到才回退到 Android 通用的 204 检测地址。
# 这样不把任何厂商域名写死在脚本里。
health_probe_url() {
  if [ -n "${HEALTH_PROBE_URL_CACHE}" ]; then
    printf '%s\n' "${HEALTH_PROBE_URL_CACHE}"
    return 0
  fi
  local u
  u=$(sed -n "s/.*url:[[:space:]]*'\(https\{0,1\}:\/\/[^']*\)'.*/\1/p" "${mihomo_config}" 2>/dev/null \
    | grep -v -E '127\.0\.0\.1|localhost' | head -n 1)
  if [ -z "${u}" ]; then
    u=$(sed -n 's/.*url:[[:space:]]*"\(https\{0,1\}:\/\/[^"]*\)".*/\1/p' "${mihomo_config}" 2>/dev/null \
      | grep -v -E '127\.0\.0\.1|localhost' | head -n 1)
  fi
  [ -n "${u}" ] || u="https://www.gstatic.com/generate_204"
  HEALTH_PROBE_URL_CACHE="${u}"
  printf '%s\n' "${u}"
}

health_underlay_iface() {
  local iface netid
  netid=$(dumpsys connectivity 2>/dev/null | sed -n 's/^Active default network: \([0-9][0-9]*\).*/\1/p' | head -n 1)
  if [ -n "${netid}" ]; then
    iface=$(dumpsys connectivity 2>/dev/null | grep -m1 "network{${netid}}" | sed -n 's/.*InterfaceName: \([A-Za-z0-9_.-]*\).*/\1/p')
  fi
  if [ -z "${iface}" ]; then
    iface=$(ip route show table all 2>/dev/null \
      | grep -E '^default ' \
      | grep -vE 'dev (mihoyo|dummy0|lo|ifb[0-9])' \
      | sed -n 's/.*dev \([^ ]*\).*/\1/p' \
      | head -n 1)
  fi
  [ -n "${iface}" ] && printf '%s\n' "${iface}"
}

health_tun_present() {
  ip link show "${tun_device:-mihoyo}" >/dev/null 2>&1
}

# 代理层探测：走 TUN 默认路由，必须 fail 快、且不依赖 DNS 之外的中间件
health_proxy_probe() {
  local target code
  target=$(health_probe_url)
  code=$(curl -s -m 8 -o /dev/null -w '%{http_code}' "${target}" 2>/dev/null)
  case "${code}" in
    2*|3*) return 0 ;;
    *) return 1 ;;
  esac
}

# 底层就绪判断：Android 网络验证标志（VALIDATED），不发请求
health_underlay_probe() {
  # 首选 Android 网络验证标志（VALIDATED，AOSP 标准，不发请求、不受墙影响）。
  # 但部分 ROM 不跑网络验证服务，该标志永远不置位——此时回退到
  # “有默认网络 + 该网卡有默认路由”的结构判断，避免永远判未就绪使看门狗失效。
  local netid iface
  netid=$(dumpsys connectivity 2>/dev/null | sed -n 's/^Active default network: \([0-9][0-9]*\).*/\1/p' | head -n 1)
  if [ -n "${netid}" ]; then
    dumpsys connectivity 2>/dev/null | grep -m1 "network{${netid}}" | grep -q 'VALIDATED' && return 0
  fi
  iface=$(health_underlay_iface)
  [ -n "${iface}" ] || return 1
  ip route show table all 2>/dev/null | grep -q "dev ${iface} "
}

health_cooldown_ok() {
  local now last
  now=$(date +%s)
  last=0
  [ -f "${HEALTH_STATE_FILE}" ] && last=$(cat "${HEALTH_STATE_FILE}" 2>/dev/null)
  case "${last}" in
    ''|*[!0-9]*) last=0 ;;
  esac
  [ $((now - last)) -ge ${HEALTH_COOLDOWN} ]
}

health_restart_allowed() {
  local now ts recent count
  now=$(date +%s)
  recent=""
  if [ -f "${HEALTH_RESTART_FILE}" ]; then
    for ts in $(cat "${HEALTH_RESTART_FILE}" 2>/dev/null); do
      case "${ts}" in
        ''|*[!0-9]*) continue ;;
      esac
      [ $((now - ts)) -lt ${HEALTH_RESTART_WINDOW} ] && recent="${recent}${ts} "
    done
  fi
  printf '%s\n' "${recent}" > "${HEALTH_RESTART_FILE}" 2>/dev/null || true
  count=$(printf '%s' "${recent}" | wc -w)
  [ "${count}" -lt "${HEALTH_RESTART_LIMIT}" ]
}

health_record_restart() {
  local recent
  recent=""
  [ -f "${HEALTH_RESTART_FILE}" ] && recent=$(cat "${HEALTH_RESTART_FILE}" 2>/dev/null)
  printf '%s%s\n' "${recent}" "$(date +%s) " > "${HEALTH_RESTART_FILE}" 2>/dev/null || true
}

health_current_pid() {
  cat "${BOX_PID_FILE}" 2>/dev/null
}

# 重启后等待流程真正完成：新 PID 出现 + TUN 设备就绪
health_wait_restart_done() {
  local old_pid="$1"
  local waited=0
  local now_pid

  while [ "${waited}" -lt ${HEALTH_RESTART_WAIT} ]; do
    now_pid=$(health_current_pid)
    if [ -n "${now_pid}" ] && [ "${now_pid}" != "${old_pid}" ] && kill -0 "${now_pid}" 2>/dev/null && health_tun_present; then
      # 核心已起、TUN 已建，但 provider 仍需从订阅加载。
      # 立即探测会把加载中误判为不可用，误消耗重启额度。
      busybox sleep ${HEALTH_RESTART_SETTLE}
      return 0
    fi
    busybox sleep 2
    waited=$((waited + 2))
  done
  return 1
}

# 读取控制端口与密钥（API 探测与 reload 共用），输出两行：端口、密钥
health_api_auth() {
  local ctrl port secret
  [ -f "${mihomo_config}" ] || return 1
  ctrl=$(sed -n 's/^external-controller:[[:space:]]*//p' "${mihomo_config}" 2>/dev/null | head -n 1 | sed 's/[[:space:]]*#.*//' | tr -d "\"' \r")
  secret=$(sed -n 's/^secret:[[:space:]]*//p' "${mihomo_config}" 2>/dev/null | head -n 1 | sed 's/[[:space:]]*#.*//' | tr -d "\"' \r")
  port="9090"
  [ -n "${ctrl}" ] && port="${ctrl##*:}"
  case "${port}" in
    ''|*[!0-9]*) return 1 ;;
  esac
  printf '%s\n%s\n' "${port}" "${secret}"
}


urlencode() {
  printf '%s' "$1" | od -An -tx1 -v | tr -d ' \n' | sed 's/../%&/g'
}

# provider 级二次确认：触发各 proxy-provider 的健康检查，再统计 alive 节点。
# 返回 0=有可用节点 1=全部不可用 2=取不到数据
health_provider_alive_check() {
  local port="$1" secret="$2" names name enc resp alive

  if [ -n "${secret}" ]; then
    resp=$(curl -s -m 8 -H "Authorization: Bearer ${secret}" "http://127.0.0.1:${port}/providers/proxies" 2>/dev/null)
  else
    resp=$(curl -s -m 8 "http://127.0.0.1:${port}/providers/proxies" 2>/dev/null)
  fi
  [ -n "${resp}" ] || return 2

  names=$(printf '%s' "${resp}" | sed 's/},{/}\n{/g' | grep '"vehicleType":"HTTP"' | sed -n 's/.*"name":"\([^"]*\)".*/\1/p')
  [ -n "${names}" ] || return 2

  for name in ${names}; do
    enc=$(urlencode "${name}")
    if [ -n "${secret}" ]; then
      curl -s -m 10 -o /dev/null -H "Authorization: Bearer ${secret}" "http://127.0.0.1:${port}/providers/proxies/${enc}/healthcheck" 2>/dev/null
    else
      curl -s -m 10 -o /dev/null "http://127.0.0.1:${port}/providers/proxies/${enc}/healthcheck" 2>/dev/null
    fi
  done

  busybox sleep 12

  for name in ${names}; do
    enc=$(urlencode "${name}")
    if [ -n "${secret}" ]; then
      resp=$(curl -s -m 8 -H "Authorization: Bearer ${secret}" "http://127.0.0.1:${port}/providers/proxies/${enc}" 2>/dev/null)
    else
      resp=$(curl -s -m 8 "http://127.0.0.1:${port}/providers/proxies/${enc}" 2>/dev/null)
    fi
    [ -n "${resp}" ] || continue
    alive=$(printf '%s' "${resp}" | grep -o '"alive":true' | wc -l)
    [ "${alive}" -gt 0 ] && return 0
  done

  return 1
}

# 节点可用性探测
#   1) 存在 proxy-providers：触发健康检查后统计 alive 节点
#   2) 无 provider 或 provider 全部不可用：对 /proxies 中的节点做延迟测试
#   3) 两者都取不到：返回 unknown，调用方不做动作
# 不依赖任何组名或组类型，适配不同配置结构。
health_provider_probe() {
  local auth port secret state

  auth=$(health_api_auth) || { printf 'unknown\n'; return 2; }
  port=$(printf '%s\n' "${auth}" | sed -n '1p')
  secret=$(printf '%s\n' "${auth}" | sed -n '2p')

  health_provider_alive_check "${port}" "${secret}"
  state=$?

  if [ "${state}" = "0" ]; then
    printf 'ok\n'
    return 0
  fi

  if health_probe_direct_nodes "${port}" "${secret}"; then
    printf 'ok\n'
    return 0
  fi

  if [ "${state}" = "1" ]; then
    printf 'fail\n'
    return 1
  fi

  printf 'unknown\n'
  return 2
}

health_reload_mihomo() {
  local ctrl port secret
  [ -f "${mihomo_config}" ] || return 1
  ctrl=$(sed -n 's/^external-controller:[[:space:]]*//p' "${mihomo_config}" 2>/dev/null | head -n 1 | sed 's/[[:space:]]*#.*//' | tr -d "\"' \r")
  secret=$(sed -n 's/^secret:[[:space:]]*//p' "${mihomo_config}" 2>/dev/null | head -n 1 | sed 's/[[:space:]]*#.*//' | tr -d "\"' \r")
  port="9090"
  [ -n "${ctrl}" ] && port="${ctrl##*:}"
  case "${port}" in
    ''|*[!0-9]*) return 1 ;;
  esac
  if [ -n "${secret}" ]; then
    curl -s -m 10 -o /dev/null -X PUT \
      -H "Authorization: Bearer ${secret}" \
      -H 'Content-Type: application/json' \
      -d "{\"path\":\"${mihomo_config}\"}" \
      "http://127.0.0.1:${port}/configs?force=true" 2>/dev/null
  else
    curl -s -m 10 -o /dev/null -X PUT \
      -H 'Content-Type: application/json' \
      -d "{\"path\":\"${mihomo_config}\"}" \
      "http://127.0.0.1:${port}/configs?force=true" 2>/dev/null
  fi
}

# 等待底层就绪：每 HEALTH_UNDERLAY_INTERVAL 秒探测一次。
# 就绪则输出网卡名并返回 0；服务被停掉或超时返回 1。
health_await_underlay() {
  local attempt=0 iface
  while [ "${attempt}" -lt ${HEALTH_UNDERLAY_RETRIES} ]; do
    if ! is_service_running; then
      return 1
    fi
    if health_underlay_probe; then
      iface=$(health_underlay_iface)
      printf '%s\n' "${iface:-default}"
      return 0
    fi
    attempt=$((attempt + 1))
    [ "${attempt}" -lt ${HEALTH_UNDERLAY_RETRIES} ] || break
    busybox sleep ${HEALTH_UNDERLAY_INTERVAL}
  done
  return 1
}

# 延时兜底：等待超时后再自动补查一次（最多 HEALTH_DEFER_ROUNDS 轮）
health_schedule_deferred_check() {
  local rounds=0
  [ -f "${HEALTH_DEFER_FILE}" ] && rounds=$(cat "${HEALTH_DEFER_FILE}" 2>/dev/null)
  case "${rounds}" in
    ''|*[!0-9]*) rounds=0 ;;
  esac
  if [ "${rounds}" -ge ${HEALTH_DEFER_ROUNDS} ]; then
    health_log "Info" "看门狗: 延时兜底已用完（${HEALTH_DEFER_ROUNDS} 轮），等下次网络事件"
    return 0
  fi
  rounds=$((rounds + 1))
  printf '%s\n' "${rounds}" > "${HEALTH_DEFER_FILE}" 2>/dev/null || true
  health_log "Info" "看门狗: ${HEALTH_DEFER_DELAY}s 后再补一次检查（${rounds}/${HEALTH_DEFER_ROUNDS}）"
  (
    busybox sleep ${HEALTH_DEFER_DELAY}
    "${SCRIPTS_DIR}/net.inotify" w
  ) >/dev/null 2>&1 &
}

health_clear_defer() {
  rm -f "${HEALTH_DEFER_FILE}" 2>/dev/null || true
}

# 判定正常后主动触发一次全量健康检查，让面板上的节点延迟刷新出来，
# 避免“节点可用但面板一片黑”。只发触发请求，不等结果。
# 3 分钟内最多一次，防止网络抖动时反复测速。
health_refresh_delays() {
  local auth port secret names name enc now last
  now=$(date +%s)
  last=0
  [ -f "${STATE_DIR}/health_refresh.last" ] && last=$(cat "${STATE_DIR}/health_refresh.last" 2>/dev/null)
  case "${last}" in
    ''|*[!0-9]*) last=0 ;;
  esac
  [ $((now - last)) -lt 180 ] && return 0

  auth=$(health_api_auth) || return 0
  port=$(printf '%s\n' "${auth}" | sed -n '1p')
  secret=$(printf '%s\n' "${auth}" | sed -n '2p')

  if [ -n "${secret}" ]; then
    names=$(curl -s -m 8 -H "Authorization: Bearer ${secret}" "http://127.0.0.1:${port}/providers/proxies" 2>/dev/null | sed 's/},{/}\n{/g' | grep '"vehicleType":"HTTP"' | sed -n 's/.*"name":"\([^"]*\)".*/\1/p')
  else
    names=$(curl -s -m 8 "http://127.0.0.1:${port}/providers/proxies" 2>/dev/null | sed 's/},{/}\n{/g' | grep '"vehicleType":"HTTP"' | sed -n 's/.*"name":"\([^"]*\)".*/\1/p')
  fi
  [ -n "${names}" ] || return 0

  date +%s > "${STATE_DIR}/health_refresh.last" 2>/dev/null || true
  for name in ${names}; do
    enc=$(urlencode "${name}")
    if [ -n "${secret}" ]; then
      curl -s -m 5 -o /dev/null -H "Authorization: Bearer ${secret}" "http://127.0.0.1:${port}/providers/proxies/${enc}/healthcheck" 2>/dev/null
    else
      curl -s -m 5 -o /dev/null "http://127.0.0.1:${port}/providers/proxies/${enc}/healthcheck" 2>/dev/null
    fi
  done
  health_log "Info" "看门狗: 已触发延迟刷新，面板节点状态会在十几秒内更新"
}

# 最后一层兜底：直接测 /proxies 里的真实节点（手写节点在集合里，
# provider 节点不在该集合里，所以不会误测）。
# 返回 0=有节点可用 1=没有可用节点或取不到
health_probe_direct_nodes() {
  local port="$1" secret="$2" tmp names name enc code resp
  tmp="${STATE_DIR}/health_direct.json"
  if [ -n "${secret}" ]; then
    curl -s -m 8 -H "Authorization: Bearer ${secret}" "http://127.0.0.1:${port}/proxies" -o "${tmp}" 2>/dev/null
  else
    curl -s -m 8 "http://127.0.0.1:${port}/proxies" -o "${tmp}" 2>/dev/null
  fi
  if [ ! -s "${tmp}" ]; then
    rm -f "${tmp}" 2>/dev/null
    return 1
  fi

  names=$(sed 's/},{/}\n{/g' "${tmp}" 2>/dev/null \
    | grep -E '"type":"(Shadowsocks|Vmess|Trojan|Vless|Tuic|Hysteria|Hysteria2|WireGuard|Socks5|Http)"' \
    | sed -n 's/.*"name":"\([^"]*\)".*/\1/p' \
    | head -n 3)
  rm -f "${tmp}" 2>/dev/null
  [ -n "${names}" ] || return 1

  for name in ${names}; do
    enc=$(urlencode "${name}")
    if [ -n "${secret}" ]; then
      resp=$(curl -s -m 8 -w '\n%{http_code}' -H "Authorization: Bearer ${secret}" "http://127.0.0.1:${port}/proxies/${enc}/delay?url=$(urlencode "$(health_probe_url)")&timeout=4000" 2>/dev/null)
    else
      resp=$(curl -s -m 8 -w '\n%{http_code}' "http://127.0.0.1:${port}/proxies/${enc}/delay?url=$(urlencode "$(health_probe_url)")&timeout=4000" 2>/dev/null)
    fi
    code=$(printf '%s\n' "${resp}" | tail -n 1)
    if [ "${code}" = "200" ]; then
      printf '%s\n' "${resp}" | grep -qE '"[^"]+":[0-9]+' && return 0
      printf '%s\n' "${resp}" | grep -q '"delay"' && return 0
    fi
  done
  return 1
}

# 端到端探测通过时，进一步确认节点可用（节点全黑时链路仍可能通）
health_check_provider_path() {
  local pstate old_pid
  pstate=$(health_provider_probe)
  case "${pstate}" in
    ok)
      health_log "Info" "看门狗: 出网正常（节点可用）"
      health_clear_defer
      health_refresh_delays
      return 0
      ;;
    fail)
      health_log "Warn" "看门狗: 出网探测通过但节点全部不可用，尝试重载 mihomo 配置"
      health_reload_mihomo >/dev/null 2>&1
      busybox sleep 8
      if [ "$(health_provider_probe)" = "ok" ]; then
        health_log "Info" "看门狗: 重载后节点恢复"
        health_clear_defer
        health_refresh_delays
        return 0
      fi
      if ! health_restart_allowed; then
        health_log "Warn" "看门狗: 10 分钟内已有效重启 ${HEALTH_RESTART_LIMIT} 次，跳过本次重启"
        return 0
      fi
      health_log "Warn" "看门狗: 重载无效，重启核心以刷新接口绑定"
      old_pid=$(health_current_pid)
      if command -v setsid >/dev/null 2>&1; then
        setsid "${SCRIPTS_DIR}/box.service" restart >/dev/null 2>&1
      else
        "${SCRIPTS_DIR}/box.service" restart >/dev/null 2>&1
      fi
      if health_wait_restart_done "${old_pid}"; then
        if [ "$(health_provider_probe)" = "ok" ]; then
          health_log "Info" "看门狗: 重启后节点恢复"
          health_clear_defer
          health_refresh_delays
        else
          health_record_restart
          health_log "Warn" "看门狗: 重启后节点仍不可用，已计入有效失败"
        fi
      else
        health_log "Warn" "看门狗: 重启未在 ${HEALTH_RESTART_WAIT}s 内就绪，不计入额度"
      fi
      return 0
      ;;
    *)
      health_log "Info" "看门狗: 无法判断节点状态（无候选组/无 provider/无手写节点），跳过"
      return 0
      ;;
  esac
}

watch_tun_health() {
  local enabled="true"
  local iface round waited old_pid lock_age

  [ "${enabled}" = "true" ] || return 0
  [ "${network_mode}" = "tun" ] || return 0
  [ "${bin_name}" = "mihomo" ] || return 0
  command -v curl >/dev/null 2>&1 || return 0
  is_service_running || return 0

  ensure_dirs
  # 清理陈旧锁：进程被强杀或设备重启后，锁目录会留在 /data 里，
  # 否则 mkdir 会持续失败，看门狗无法启动。
  if [ -d "${HEALTH_LOCK_DIR}" ]; then
    lock_age=$(( $(date +%s) - $(stat -c %Y "${HEALTH_LOCK_DIR}" 2>/dev/null || echo 0) ))
    if [ "${lock_age}" -gt ${HEALTH_LOCK_STALE} ]; then
      rmdir "${HEALTH_LOCK_DIR}" 2>/dev/null || true
      health_log "Warn" "看门狗: 清理陈旧锁（已残留 ${lock_age}s）"
    fi
  fi
  mkdir "${HEALTH_LOCK_DIR}" 2>/dev/null || return 0
  trap 'rmdir "${HEALTH_LOCK_DIR}" 2>/dev/null' EXIT

  health_cooldown_ok || return 0
  date +%s > "${HEALTH_STATE_FILE}" 2>/dev/null || true

  busybox sleep ${HEALTH_DELAY}
  is_service_running || return 0

  # TUN 是代理链路的前提。核心在运行却没有 TUN，说明创建失败
  # （常见原因：启动时 iptables 锁被占用），此时后续探测都无意义，直接重建。
  if ! health_tun_present; then
    health_log "Warn" "看门狗: TUN 设备不存在，重建核心"
    if ! health_restart_allowed; then
      health_log "Warn" "看门狗: 10 分钟内已有效重启 ${HEALTH_RESTART_LIMIT} 次，跳过本次重建"
      return 0
    fi
    old_pid=$(health_current_pid)
    if command -v setsid >/dev/null 2>&1; then
      setsid "${SCRIPTS_DIR}/box.service" restart >/dev/null 2>&1
    else
      "${SCRIPTS_DIR}/box.service" restart >/dev/null 2>&1
    fi
    if health_wait_restart_done "${old_pid}"; then
      health_log "Info" "看门狗: TUN 已重建"
      health_clear_defer
      health_refresh_delays
    else
      health_record_restart
      health_log "Warn" "看门狗: TUN 仍未建立，已计入有效失败"
    fi
    return 0
  fi

  # 第一跳：端到端探测。通过说明链路与节点均正常，直接进入节点确认。
  if health_proxy_probe; then
    health_check_provider_path
    return 0
  fi

  # 端到端不通：可能确实没信号，也可能刚恢复、底层仍在初始化。
  # 在 3 分钟窗口内反复确认，一旦底层就绪就继续往下判断。
  iface=$(health_await_underlay)
  if [ -z "${iface}" ]; then
    health_log "Info" "看门狗: 等待 $((HEALTH_UNDERLAY_RETRIES * HEALTH_UNDERLAY_INTERVAL))s 后底层仍未就绪（疑似无信号），本次不动作"
    health_schedule_deferred_check
    return 0
  fi

  health_log "Info" "看门狗: 底层已就绪（${iface}），复查代理路径"

  if health_proxy_probe; then
    health_check_provider_path
    return 0
  fi

  health_log "Warn" "看门狗: 底层 ${iface} 正常但代理不通，尝试重载 mihomo 配置"
  health_reload_mihomo >/dev/null 2>&1
  busybox sleep 8
  if health_proxy_probe; then
    health_log "Info" "看门狗: 重载后恢复正常"
    health_clear_defer
    health_refresh_delays
    return 0
  fi

  if ! health_restart_allowed; then
    health_log "Warn" "看门狗: 10 分钟内已有效重启 ${HEALTH_RESTART_LIMIT} 次，退化为低频轮询"
    round=0
    waited=0
    while [ "${round}" -lt ${HEALTH_RECHECK_ROUNDS} ]; do
      busybox sleep ${HEALTH_RECHECK_INTERVAL}
      round=$((round + 1))
      waited=$((waited + HEALTH_RECHECK_INTERVAL))
      if ! is_service_running; then
        health_log "Info" "看门狗: 轮询中检测到服务已停止，退出"
        return 0
      fi
      if health_proxy_probe; then
        health_log "Info" "看门狗: 轮询 ${waited}s 后出网自行恢复"
        health_clear_defer
        health_refresh_delays
        return 0
      fi
    done
    health_log "Warn" "看门狗: 轮询结束仍未恢复，等待下次网络事件"
    return 0
  fi

  health_log "Warn" "看门狗: 重载无效，重启核心服务"
  old_pid=$(health_current_pid)
  # setsid: 让核心脱离调用者的进程组，避免被上层会话清理一并杀掉
  if command -v setsid >/dev/null 2>&1; then
    setsid "${SCRIPTS_DIR}/box.service" restart >/dev/null 2>&1
  else
    "${SCRIPTS_DIR}/box.service" restart >/dev/null 2>&1
  fi

  if ! health_wait_restart_done "${old_pid}"; then
    health_log "Warn" "看门狗: 重启未在 ${HEALTH_RESTART_WAIT}s 内就绪，不计入额度"
    return 0
  fi

  if health_proxy_probe; then
    health_log "Info" "看门狗: 重启后恢复正常"
    health_clear_defer
    health_refresh_delays
    return 0
  fi

  health_record_restart
  health_log "Warn" "看门狗: 重启后底层通但代理仍不通，已计入有效失败（可能是节点或配置问题）"
}

if [ "${events}" = "w" ]; then
  reset_event_logs
  if [ ! -f "${BASE_DIR}/settings.ini" ]; then
    net_log_warn "未找到 settings.ini，跳过本次处理"
    exit 0
  fi

  . "${BASE_DIR}/settings.ini"
  if [ -f "${BOX_PID_FILE}" ]; then
    update_local_ip_rules
  else
    net_log_info "未检测到运行中的核心进程，跳过防回环规则更新"
  fi
  apply_network_control_policy
  ( watch_tun_health ) &
fi
